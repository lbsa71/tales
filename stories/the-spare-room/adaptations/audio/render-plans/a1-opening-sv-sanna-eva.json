    {
      "kind": "dialogue",
      "source_spoken": true,
      "speaker": "RUT",
      "tags": "[dryly]",
      "text": "Har vi det?"
    },
    {
      "kind": "comment",
      "comment": "[SPEL: Rut putsar glasögonen. Helena fortsätter hålla upp kappan tills det blir för ansträngande.]"
    },
    {
      "kind": "dialogue",
      "source_spoken": true,
      "speaker": "HELENA",
      "tags": "[strained]",
      "text": "Jag får kramp."
    },
    {
      "kind": "dialogue",
      "source_spoken": true,
      "speaker": "RUT",
      "tags": "[matter-of-fact]",
      "text": "Lägg ner den då."
