  "items": [
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[calmly]", "text": "Helena väntar."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[firmly]", "text": "Sätt igång."},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Jag håller på."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Jaha."},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[measured]", "text": "En kort stund går… [pause]"},
    {"kind": "dialogue", "speaker": "KIM", "text": "Du behöver inte titta på henne."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Var vill du att jag ska titta?"},
    {"kind": "dialogue", "speaker": "KIM", "text": "Var som helst."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[deadpan]", "text": "Det är där jag tittar."},
    {"kind": "reaction", "speaker": "HELENA", "direction": "[an involuntary little laugh]", "text": "Ha."},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[quietly]", "text": "Helena sjunker ner i stolen, lite vänd mot Kim."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Är det klart nu?"},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Nästan."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Säg till när."},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[a warning]", "text": "Mamma."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Så kan jag börja vara tyst."},
    {"kind": "narration", "speaker": "BERÄTTARE", "text": "Kim vänder sig mot Helena."},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[curious]", "text": "Är det hamnen?"},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[briefly]", "text": "Helena nickar."},
    {"kind": "dialogue", "speaker": "KIM", "text": "Får jag?"},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[guiding, unhurried]", "text": "Ja. Vänta. Låt det komma till dig."},
    {"kind": "narration", "speaker": "BERÄTTARE", "text": "Kim sätter sig och drar upp axlarna."},
    {"kind": "reaction", "speaker": "KIM", "direction": "[a surprised little laugh]", "text": "Ha!"},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[shivering, delighted]", "text": "Åh, vad kallt."},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Du bad om det."},
    {"kind": "dialogue", "speaker": "KIM", "text": "Var står jag?"},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Stå inte någonstans."},
    {"kind": "dialogue", "speaker": "KIM", "text": "Någonstans måste jag stå."},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[amused]", "text": "Det är därför du ramlar i hela tiden."},
    {"kind": "narration", "speaker": "BERÄTTARE", "text": "Kim koncentrerar sig och anpassar sig."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Är du våt om fötterna?"},
    {"kind": "dialogue", "speaker": "KIM", "text": "Nej."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Jaha."},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Du kan ta en titt."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Jag sitter bra här."},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Du behöver inte resa dig."},
    {"kind": "dialogue", "speaker": "RUT", "text": "Det vet jag, Helena."},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[after a beat]", "text": "Helena låter erbjudandet falla."},
    {"kind": "dialogue", "speaker": "KIM", "text": "Någon har lämnat en –"},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Jag vet."},
    {"kind": "dialogue", "speaker": "KIM", "text": "Den kommer bort."},
    {"kind": "dialogue", "speaker": "HELENA", "text": "Den är fastbunden."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[wanting in]", "text": "Vad då?"},
    {"kind": "dialogue", "speaker": "HELENA", "text": "En liten båt."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[probing]", "text": "Vad för sorts båt?"},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[simply]", "text": "Röd."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[correcting her]", "text": "Det är ingen sorts båt."},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[absorbed]", "text": "Väldigt liten. Med något i."},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[briefly]", "text": "Helena är på väg att säga något."},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[interrupting, surprised]", "text": "En sko."},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[a beat]", "text": "Helena ser på Kim."},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[apologetic]", "text": "Förlåt. Du tittade just på den."},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[gently admonishing]", "text": "Du får titta. Du behöver inte säga allt."},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[still amused]", "text": "Det var en väldigt plötslig sko."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[with authority]", "text": "Skor dyker faktiskt upp i båtar."},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[curious despite herself]", "text": "Gör de?"},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[pleased with the logic]", "text": "Om någon ger sig ut med två och kommer tillbaka med en är det där jag skulle leta."},
    {"kind": "reaction", "speaker": "KIM", "direction": "[bursts into laughter]", "text": "Ha, ha, ha!"},
    {"kind": "reaction", "speaker": "HELENA", "direction": "[laughs with Kim]", "text": "Ha ha!"},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[baffled]", "text": "Vad?"},
    {"kind": "dialogue", "speaker": "KIM", "direction": "[trying to stop laughing]", "text": "Inget."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[defensive]", "text": "Jag har inte sagt något roligt."},
    {"kind": "dialogue", "speaker": "HELENA", "direction": "[smiling]", "text": "Du lät så nöjd med dig själv."},
    {"kind": "dialogue", "speaker": "RUT", "direction": "[matter-of-fact, faintly pleased]", "text": "Ja, jag har ju löst det."},
    {"kind": "reaction", "speaker": "KIM", "direction": "[keeps laughing]", "text": "Ha, ha!"},
    {"kind": "reaction", "speaker": "HELENA", "direction": "[still laughing]", "text": "Ha ha!"},
    {"kind": "reaction", "speaker": "RUT", "direction": "[finally gives in and laughs]", "text": "Ha!"},
    {"kind": "narration", "speaker": "BERÄTTARE", "direction": "[warmly]", "text": "De skrattar fortfarande. Till slut tillåter sig Rut att skratta med."}
  ]
}
